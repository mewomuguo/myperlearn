{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/insurance-study/v1.schema.json",
  "title": "15天人身保險考試通關系統 V1",
  "description": "教材包與學習紀錄包。跨實體ID、日期條件、題目規則等另由應用層語義驗證；analysis目錄不宣稱為已審核教材包。",
  "oneOf": [
    {
      "$ref": "#/$defs/ContentPack"
    },
    {
      "$ref": "#/$defs/RecordExport"
    }
  ],
  "$defs": {
    "Priority": {
      "type": "string",
      "enum": [
        "MUST",
        "SHOULD",
        "OPTIONAL"
      ]
    },
    "Tag": {
      "type": "string",
      "enum": [
        "理解",
        "必背",
        "數字／期限",
        "易混淆",
        "計算",
        "情境題",
        "法規題"
      ]
    },
    "ReviewStatus": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "verified",
        "quarantined",
        "retired"
      ]
    },
    "ErrorType": {
      "type": "string",
      "enum": [
        "concept",
        "number",
        "confusion",
        "misread",
        "calculation",
        "guess",
        "unclassified"
      ]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "lecture_body",
            "toc_star",
            "a_plus",
            "chapter_question",
            "cross_chapter",
            "official_rule",
            "external_question"
          ]
        },
        "pdfPages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 114
          },
          "minItems": 0
        },
        "printedPages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 4,
            "maximum": 117
          },
          "minItems": 0
        },
        "questionNumbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 0
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sourceId",
        "kind",
        "pdfPages",
        "printedPages",
        "questionNumbers",
        "note"
      ]
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "lecture",
            "official",
            "external"
          ]
        },
        "edition": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "accessedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "type": "string",
          "enum": [
            "private_reference",
            "public_allowed",
            "original_summary",
            "unknown"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "edition",
        "url",
        "accessedAt",
        "sha256",
        "usage",
        "notes"
      ]
    },
    "Chapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "enum": [
            "保險實務",
            "保險法規"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "stars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "questionCount": {
          "type": "integer",
          "minimum": 0
        },
        "aPlusBlockCount": {
          "type": "integer",
          "minimum": 0
        },
        "importanceScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "unit",
        "title",
        "stars",
        "questionCount",
        "aPlusBlockCount",
        "importanceScore",
        "evidence"
      ]
    },
    "Lesson": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plainExplanation": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "type": "string",
          "minLength": 1
        },
        "mustRecall": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "confusions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "withConceptId": {
                "type": "string",
                "minLength": 1
              },
              "difference": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "withConceptId",
              "difference"
            ]
          },
          "minItems": 0
        },
        "checkQuestionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "plainExplanation",
        "example",
        "mustRecall",
        "confusions",
        "checkQuestionIds",
        "estimatedMinutes"
      ]
    },
    "Concept": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "canonicalConceptId": {
          "type": "string",
          "minLength": 1
        },
        "chapterIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        },
        "priorityReason": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tag"
          },
          "minItems": 1
        },
        "prerequisiteIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "relatedConceptIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "firstDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 11
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "importanceScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "lectureQuestionFamilyCount": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1
        },
        "lesson": {
          "$ref": "#/$defs/Lesson"
        },
        "numberCardIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "reviewStatus": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "canonicalConceptId",
        "chapterIds",
        "title",
        "priority",
        "priorityReason",
        "tags",
        "prerequisiteIds",
        "relatedConceptIds",
        "firstDay",
        "outcome",
        "importanceScore",
        "lectureQuestionFamilyCount",
        "evidence",
        "lesson",
        "numberCardIds",
        "reviewStatus",
        "version"
      ]
    },
    "RuleScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "effectiveFrom": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "effectiveTo": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "examScopeStatus": {
          "type": "string",
          "enum": [
            "unconfirmed",
            "confirmed",
            "historical"
          ]
        },
        "verificationSourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "checkedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflictNote": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "edition",
        "effectiveFrom",
        "effectiveTo",
        "examScopeStatus",
        "verificationSourceIds",
        "checkedAt",
        "conflictNote"
      ]
    },
    "Question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "familyId": {
          "type": "string",
          "minLength": 1
        },
        "conceptIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "primaryConceptId": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "enum": [
            "lecture_original",
            "lecture_adapted",
            "external"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "single_choice",
            "statement_combination",
            "calculation_choice",
            "scenario_choice",
            "recall"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tag"
          },
          "minItems": 1
        },
        "stem": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text"
            ]
          },
          "minItems": 0
        },
        "correctOptionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptedAnswers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "optionExplanations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "optionId": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "optionId",
              "reason"
            ]
          },
          "minItems": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1
        },
        "ruleScope": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewStatus": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "reviewedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "type": "string",
          "enum": [
            "private_only",
            "public_allowed",
            "original"
          ]
        },
        "estimatedSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version",
        "familyId",
        "conceptIds",
        "primaryConceptId",
        "origin",
        "type",
        "tags",
        "stem",
        "options",
        "correctOptionId",
        "acceptedAnswers",
        "explanation",
        "optionExplanations",
        "evidence",
        "ruleScope",
        "reviewStatus",
        "reviewedAt",
        "usage",
        "estimatedSeconds"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "recall"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "maxItems": 0
              },
              "correctOptionId": {
                "type": "null"
              },
              "acceptedAnswers": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "options": {
                "minItems": 4,
                "maxItems": 4
              },
              "correctOptionId": {
                "type": "string",
                "minLength": 1
              },
              "acceptedAnswers": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "NumberCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "conceptId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "startRule": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "day",
            "business_day",
            "month",
            "year",
            "percent",
            "age",
            "TWD",
            "count",
            "hour",
            "ratio"
          ]
        },
        "operator": {
          "type": "string",
          "enum": [
            "eq",
            "lt",
            "lte",
            "gt",
            "gte"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "confusableCardIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "questionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "ruleScope": {
          "$ref": "#/$defs/RuleScope"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1
        },
        "reviewStatus": {
          "$ref": "#/$defs/ReviewStatus"
        }
      },
      "required": [
        "id",
        "conceptId",
        "title",
        "priority",
        "subject",
        "trigger",
        "startRule",
        "value",
        "unit",
        "operator",
        "conditions",
        "exceptions",
        "confusableCardIds",
        "questionIds",
        "ruleScope",
        "evidence",
        "reviewStatus"
      ]
    },
    "ExamSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "questionCount": {
          "type": "integer",
          "minimum": 1
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "pointsPerQuestion": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "passScore": {
          "type": "number"
        },
        "chapterIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "quotas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "chapterId": {
                "type": "string",
                "minLength": 1
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "chapterId",
              "count"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "title",
        "questionCount",
        "durationMinutes",
        "pointsPerQuestion",
        "passScore",
        "chapterIds",
        "quotas"
      ]
    },
    "ExamProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "unconfirmed",
            "verified"
          ]
        },
        "verificationSourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "verifiedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExamSection"
          },
          "minItems": 0
        },
        "passRule": {
          "type": "string",
          "enum": [
            "all_sections",
            "total_score",
            "unconfirmed"
          ]
        },
        "totalPassScore": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "bufferPoints": {
          "type": "integer",
          "minimum": 0
        },
        "unansweredIsWrong": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "verificationSourceIds",
        "verifiedAt",
        "sections",
        "passRule",
        "totalPassScore",
        "bufferPoints",
        "unansweredIsWrong"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "verificationSourceIds": {
                "minItems": 1
              },
              "verifiedAt": {
                "type": "string",
                "format": "date-time"
              },
              "sections": {
                "minItems": 1
              },
              "passRule": {
                "enum": [
                  "all_sections",
                  "total_score"
                ]
              }
            }
          }
        }
      ]
    },
    "DayPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "requiredConceptIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "optionalConceptIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "newLearningAllowed": {
          "type": "boolean"
        },
        "learnMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "answerMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "reviewMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "targetQuestionsMin": {
          "type": "integer",
          "minimum": 0
        },
        "targetQuestionsMax": {
          "type": "integer",
          "minimum": 0
        },
        "fullExamCount": {
          "type": "integer",
          "minimum": 0
        },
        "examLabels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "day",
        "title",
        "requiredConceptIds",
        "optionalConceptIds",
        "newLearningAllowed",
        "learnMinutes",
        "answerMinutes",
        "reviewMinutes",
        "targetQuestionsMin",
        "targetQuestionsMax",
        "fullExamCount",
        "examLabels",
        "outcome"
      ]
    },
    "TaskItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
